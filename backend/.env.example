
# StudyIA - Plantilla de configuracion


# Este archivo SÍ se sube a Git (no tiene secretos reales).
# El archivo ".env" NO se sube nunca.



# --- Base de datos (PostgreSQL local) ---
# Formato: postgresql+psycopg://USUARIO:CONTRASENA@HOST:PUERTO/BASE
DATABASE_URL=postgresql+psycopg://studyia:CAMBIAR_ESTA_PASSWORD@localhost:5432/studyia

# Poner en "true" muestra cada consulta SQL en la terminal (util para
# demostrar que la API consulta la base). En uso normal: false.
DB_ECHO=false


# --- Autenticacion (JWT) ---
# Generá un valor aleatorio con este comando:
#     openssl rand -hex 32
JWT_SECRET=GENERA_UNO_NUEVO_CON_OPENSSL_RAND_HEX_32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120


# --- Frontend ---
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200


# --- Proveedor de Inteligencia Artificial ---
# "gemini" u "opencode". Ver README para el detalle de cada uno.
IA_PROVEEDOR=gemini

# Proveedor 1: Google Gemini 
# Key: https://aistudio.google.com -> Get API key
GEMINI_API_KEY=API-KEY
GEMINI_MODEL=gemini-2.5-flash

# Proveedor 2: OpenCode Zen (tiene modelos gratuitos)
# Key: https://opencode.ai/zen -> Create API Key
OPENCODE_API_KEY=API-KEY
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
IA_MODEL=space-bunny-free
