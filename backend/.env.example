APP_NAME=StudyIA
APP_ENV=development
DATABASE_URL=postgresql+psycopg://studyia_user:CAMBIAR_PASSWORD@localhost:5432/studyia
# Mínimo 32 caracteres. Generar con:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CAMBIAR_POR_UNA_CLAVE_SEGURA
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
# Intentos fallidos de login antes de bloquear ese email+IP durante N minutos
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Lista JSON de orígenes permitidos (frontend Angular)
CORS_ORIGINS=["http://localhost:4200"]
LLM_API_KEY=
