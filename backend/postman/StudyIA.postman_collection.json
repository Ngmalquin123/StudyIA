                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Degradado (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Ahora es estudiante', () => pm.expect(pm.response.json().rol).to.eql('estudiante'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Rol inexistente (400)",
