{
  "info": {
    "name": "StudyIA API",
    "description": "Colección para probar el backend de StudyIA.\n\n1. Levantar la API: `uv run fastapi dev src/studyia/main.py`\n2. Crear el admin (una sola vez): `uv run python -m studyia.create_admin`\n3. Ejecutar en orden, o con **Run collection**. El login guarda `token` y `userId` automáticamente.\n\nLa carpeta **Limpieza** borra el usuario de prueba para poder repetir la colección.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "email",
      "value": "luis@studyia.com"
    },
    {
      "key": "password",
      "value": "MiClave123"
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
    },
    {
      "key": "adminEmail",
      "value": "admin@studyia.com"
    },
    {
      "key": "adminPassword",
      "value": "Admin12345"
    },
    {
      "key": "adminToken",
      "value": ""
    },
    {
      "key": "editarId",
      "value": "",
      "description": "Id del usuario que el admin quiere editar. Vacío = usuario de prueba."
    },
    {
      "key": "eliminarId",
      "value": "",
      "description": "Id del usuario que el admin quiere eliminar. Vacío = se crea un usuario temporal y se elimina ese."
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('API funcionando (200)', () => pm.response.to.have.status(200));",
              "pm.test('Base de datos conectada', () => pm.expect(pm.response.json().database).to.eql('ok'));"
            ]
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Registrar usuario",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/register",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luis Malquin\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario creado (201)', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login correcto (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "    pm.collectionVariables.set('token', body.access_token);",
                  "    pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "    pm.collectionVariables.set('userId', body.user.id);",
                  "    console.log('Token y userId guardados');",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Mi perfil (protegida)",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/auth/me"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Perfil con token (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Refrescar token",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/refresh",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh_token\": \"{{refreshToken}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Tokens renovados (200)', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "if (body.access_token) {",
                  "    pm.collectionVariables.set('token', body.access_token);",
                  "    pm.collectionVariables.set('refreshToken', body.refresh_token);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Mi cuenta",
      "item": [
        {
          "name": "Editar mi usuario",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Luis Malquin Editado\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario editado (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "description": "Requiere un admin: uv run python -m studyia.create_admin",
      "item": [
        {
          "name": "Login admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "noauth"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login admin (200)', () => pm.response.to.have.status(200));",
                  "pm.collectionVariables.set('adminToken', pm.response.json().access_token);",
                  "pm.test('Es admin', () => pm.expect(pm.response.json().user.rol).to.eql('admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Listar usuarios",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users?skip=0&limit=50",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Lista de usuarios (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Ver usuario por id",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario encontrado (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Editar usuario (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Si no pusiste un id en la variable 'editarId', edita al usuario de prueba",
                  "if (!pm.collectionVariables.get('editarId')) {",
                  "    pm.variables.set('editarId', pm.collectionVariables.get('userId'));",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario editado por admin (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/users/{{editarId}}",
            "description": "El admin edita a CUALQUIER usuario.\n\n1. Busca el id con **Listar usuarios**.\n2. Pon ese id en la variable `editarId` de la colección, o reemplaza `{{editarId}}` en la URL por el número.\n3. En el body envía solo lo que quieras cambiar: `name`, `email`, `password` y/o `rol`.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Nombre cambiado por admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Eliminar usuario (admin)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "// Si no pusiste un id en 'eliminarId', se crea un usuario temporal para no borrar a nadie real",
                  "if (!pm.collectionVariables.get('eliminarId')) {",
                  "    const email = `temporal${Date.now()}@studyia.com`;",
                  "    pm.sendRequest({",
                  "        url: pm.collectionVariables.get('baseUrl') + '/api/auth/register',",
                  "        method: 'POST',",
                  "        header: { 'Content-Type': 'application/json' },",
                  "        body: { mode: 'raw', raw: JSON.stringify({ name: 'Usuario temporal', email, password: '12345678' }) }",
                  "    }, (err, res) => { pm.variables.set('eliminarId', res.json().id); });",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Usuario eliminado por admin (204)', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "method": "DELETE",
            "url": "{{baseUrl}}/api/users/{{eliminarId}}",
            "description": "El admin elimina a CUALQUIER usuario.\n\n1. Busca el id con **Listar usuarios**.\n2. Pon ese id en la variable `eliminarId` de la colección, o reemplaza `{{eliminarId}}` en la URL por el número (sin llaves).\n\nSi `eliminarId` está vacío, se crea un usuario temporal y se elimina ese, para no borrar a nadie real.\n\n⚠️ No se puede deshacer."
          }
        },
        {
          "name": "Listar roles",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/roles",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Roles (200)', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Promover usuario a admin",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rol\": \"admin\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Promovido (200)', () => pm.response.to.have.status(200));",
                  "pm.test('Ahora es admin', () => pm.expect(pm.response.json().rol).to.eql('admin'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Devolver a estudiante",
          "request": {
            "method": "PATCH",
            "url": "{{baseUrl}}/api/users/{{userId}}",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rol\": \"estudiante\"\n}",
